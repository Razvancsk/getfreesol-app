# Required: Helius API key (HELIUS_API_KEY also works)
Helius_key=your_helius_api_key

# Reown project ID from https://dashboard.reown.com (VITE_REOWN_PROJECT_ID also works)
REOWN_PROJECT_ID=30247a4ea78906563498c2736129d21f

# Optional (defaults shown)
FEES_WALLET=GetxnGXDwWfGwMmNweyCexiY3Z8KRWJjs6qviWv1uqkT
FEE_BPS=1000
PRIORITY_MICROLAMPORTS=20000

# Optional: Jupiter API key for token prices (without it the free lite API is used)
JUPITER_API_KEY=your_jupiter_api_key
